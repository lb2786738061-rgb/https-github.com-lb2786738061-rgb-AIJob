.container { padding: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 40rpx; }
.input { border: 1px solid #ddd; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; }
.btn { background: #2563eb; color: #fff; border-radius: 12rpx; margin-top: 20rpx; }
.link { color: #2563eb; font-size: 28rpx; margin-top: 30rpx; display: block; text-align: center; }
