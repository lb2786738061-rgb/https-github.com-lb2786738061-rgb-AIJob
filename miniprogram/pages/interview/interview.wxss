.container { padding: 40rpx; display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 24rpx; }
.picker { padding: 20rpx; border: 1px solid #ddd; border-radius: 12rpx; margin-bottom: 20rpx; }
.btn { background: #2563eb; color: #fff; border-radius: 12rpx; margin-top: 20rpx; }
.chat { flex: 1; margin: 20rpx 0; max-height: 60vh; }
.msg { padding: 20rpx; margin-bottom: 16rpx; border-radius: 12rpx; font-size: 28rpx; }
.msg.assistant { background: #f0f7ff; }
.msg.user { background: #2563eb; color: #fff; margin-left: 60rpx; }
.textarea { border: 1px solid #ddd; border-radius: 12rpx; padding: 16rpx; height: 120rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 16rpx; }
