.container { padding: 40rpx; }
.title { font-size: 48rpx; font-weight: bold; display: block; }
.subtitle { color: #666; font-size: 28rpx; margin: 12rpx 0 40rpx; display: block; }
.user-bar { display: flex; justify-content: space-between; padding: 20rpx; background: #f0f7ff; border-radius: 12rpx; margin-bottom: 30rpx; font-size: 28rpx; }
.login, .logout { color: #2563eb; }
.cards { display: flex; flex-direction: column; gap: 24rpx; }
.card { background: #fff; border: 1px solid #e5e7eb; border-radius: 16rpx; padding: 32rpx; }
.card-title { font-size: 34rpx; font-weight: 600; display: block; }
.card-desc { color: #666; font-size: 26rpx; margin-top: 8rpx; display: block; }
