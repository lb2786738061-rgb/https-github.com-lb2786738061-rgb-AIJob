.container { padding: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 24rpx; display: block; }
.scores { display: flex; flex-wrap: wrap; gap: 16rpx; color: #2563eb; font-size: 26rpx; margin-bottom: 24rpx; }
.summary { display: block; font-size: 28rpx; color: #333; margin-bottom: 32rpx; line-height: 1.6; }
.review { background: #f9fafb; padding: 24rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.q, .a, .fb { display: block; font-size: 26rpx; margin-bottom: 8rpx; }
.fb { color: #666; }
.hint { color: #999; font-size: 28rpx; }
