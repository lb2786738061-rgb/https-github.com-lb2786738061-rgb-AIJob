.container { padding: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 30rpx; }
.input, .textarea { border: 1px solid #ddd; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; width: 100%; box-sizing: border-box; }
.textarea { height: 200rpx; }
.btn { background: #2563eb; color: #fff; border-radius: 12rpx; }
.result { margin-top: 40rpx; padding: 24rpx; background: #f9fafb; border-radius: 16rpx; }
.result-title { font-weight: 600; font-size: 32rpx; display: block; margin-bottom: 16rpx; }
.scores { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 26rpx; color: #2563eb; margin-bottom: 16rpx; }
.match { display: block; font-size: 28rpx; margin-bottom: 16rpx; }
.issues { margin-bottom: 16rpx; }
.issue { display: block; font-size: 24rpx; color: #b45309; margin-bottom: 6rpx; }
.report { font-size: 26rpx; color: #444; white-space: pre-wrap; display: block; }
